# RankEZ upgrade credentials (no secrets - copy to your workspace as .env and fill in).
# Workspace location: ~/.rankez-upgrade/.env  (or $RANKEZ_UPGRADE_HOME/.env)
# Run `chmod 600 ~/.rankez-upgrade/.env` after creating it.

# RankEZ portal (for component auto-discovery)
RANKEZ_URL=https://192.168.0.21
RANKEZ_USERNAME=admin
RANKEZ_PASSWORD=YourPasswordHere!
RANKEZ_VERIFY_SSL=false

# Zendesk (for downloading packages)
ZENDESK_EMAIL=your_zendesk_email@example.com
ZENDESK_PASSWORD=your_zendesk_password