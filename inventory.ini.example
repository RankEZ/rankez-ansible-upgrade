# Example inventory - copy/rename to your workspace inventory dir.
# Real inventories are generated by ./rankez-upgrade inventory (or pre_upgrade_inventory.py)
# and written to ~/.rankez-upgrade/inventory/<name>.ini by default.
#
# Replace the placeholder IPs below with your own. See README "Where files live".

[primary_vault]
192.168.0.11 ansible_user=cloud-user

[standby_vault]
192.168.0.12 ansible_user=cloud-user

[vaults:children]
primary_vault
standby_vault

[pac]
192.168.0.21 ansible_user=cloud-user

[psm]
192.168.0.21 ansible_user=cloud-user

[cpm]
192.168.0.21 ansible_user=cloud-user

[cp]
192.168.0.21 ansible_user=cloud-user

[frontend:children]
pac
psm
cpm
cp

[all:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'
ansible_become=yes
upgrade_version=5.9.0
# Per-component versions (from the release manifest). Falls back to
# upgrade_version when a component is absent. Optional - omit to use
# upgrade_version for every component.
component_versions={"vault":"5.9.0","pac":"5.9.0","psm":"5.9.0","cpm":"5.9.0","cp":"5.9.0"}
current_version=5.8.0
local_bundle_dir=/absolute/path/to/packages
remote_tmp_dir=/tmp/rankez_upgrade
install_path=/opt